# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-railway-url.railway.app,localhost,127.0.0.1

# Database (auto-set by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:5432/railway

# CORS Origins (GitHub Pages and local development)
CORS_ALLOWED_ORIGINS=https://your-username.github.io/EducFarm,http://localhost:5173,http://localhost:3000

# Weather API
OPENWEATHER_API_KEY=your-openweather-api-key
